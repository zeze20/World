# Copy to .env and fill values. Never commit real secrets.

# Optional: Cesium ion access token (for ion assets). Leave empty for open data only.
# VITE_CESIUM_ION_TOKEN=

# Optional search provider (Nominatim is free & open, no key required for low volume)
# VITE_SEARCH_PROVIDER=nominatim

# Telemetry (disabled by default)
# VITE_TELEMETRY_ENABLED=false
