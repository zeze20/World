{
  "name": "aetherglobe",
  "version": "0.1.0",
  "private": true,
  "description": "AetherGlobe – Independent 3D global exploration platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aetherglobe/web",
    "build": "npm run build -w @aetherglobe/web",
    "test": "npm run test -w @aetherglobe/geo-core",
    "test:e2e": "npm run test:e2e -w @aetherglobe/web",
    "typecheck": "npm run typecheck -w @aetherglobe/geo-core && npm run typecheck -w @aetherglobe/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
